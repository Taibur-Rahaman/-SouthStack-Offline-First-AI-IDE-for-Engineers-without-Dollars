{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["infra/**/*.ts", "swarm/**/*.ts", "autonomy/**/*.ts", "evolution/**/*.ts"]
}
